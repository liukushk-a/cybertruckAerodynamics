FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          1e-5;
    }

    "(U|k|epsilon|omega|f|v2)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          1e-4;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 10;
    consistent      yes;

    residualControl
    {
        p               1e-4;
        U               1e-5;
        "(k|epsilon|omega|f|v2)" 1e-5;
    }
}

relaxationFactors
{
    equations
    {
        U                 0.7;
        k                 0.7;
        epsilon           0.7;
    }

    fields
    {
        p               0.3;
    }
}

cache
{
    grad(U);
}

potentialFlow
{
    nNonOrthogonalCorrectors    100;
}

