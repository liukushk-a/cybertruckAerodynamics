FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.0;
		nPreSweeps		0;
		nPostSweeps		2;
		cacheAgglomeration	on;
		nCellsInCoarsestLevel	1000;
		agglomeration		faceAreaPair;
		mergeLevels		1;
    }

    "(U|k|epsilon|omega|f|v2)"
    {
        solver          PBiCGStab;
        preconditioner	DILU;
        tolerance       1e-8;
        relTol          0.0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 2;
	nCorrector				 3;
	turbOnFinalIterOnly		 false;
    consistent      yes;

    residualControl
    {
        p               1e-4;
        U               1e-5;
        "(k|epsilon|omega|f|v2)" 1e-5;
    }
}

relaxationFactors
{
    equations
    {
        U                 0.8;
        k                 0.8;
        omega           0.2;
    }

    fields
    {
        p               0.4;
    }
}

cache
{
    grad(U);
}

potentialFlow
{
    nNonOrthogonalCorrectors    100;
}

